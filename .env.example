# Copie para .env e preencha. Nunca versione o .env.

# Obrigatório. Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Validade do token (padrão: 1h)
JWT_EXPIRES_IN=1h

# Com DATABASE_URL definida, a API usa o Postgres de produção.
# Sem ela, usa o MySQL local (src/data/services/dev.service.ts).
DATABASE_URL=

# Sincroniza o schema automaticamente em produção. Deixe false;
# use true só se souber o que está fazendo (pode alterar tabelas existentes).
DB_SYNCHRONIZE=false

PORT=4000
